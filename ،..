<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Elena ❤️ Nikan</title>

<style>
*{
  box-sizing:border-box;
  -webkit-tap-highlight-color:transparent;
}

html,body{
  margin:0;
  width:100%;
  min-height:100%;
}

body{
  min-height:100vh;
  overflow-x:hidden;
  overflow-y:auto;
  font-family:Tahoma,Arial,sans-serif;
  color:white;
  background:radial-gradient(circle at center,#681b55 0%,#260b23 55%,#080208 100%);
  transition:background 1s ease;
}

body.bright{
  background:radial-gradient(circle at center,#ff8ac4 0%,#7c216b 55%,#190619 100%);
}

.container{
  min-height:100vh;
  display:flex;
  justify-content:center;
  align-items:center;
  padding:25px 15px;
}

.card{
  width:100%;
  max-width:430px;
  padding:30px 20px;
  text-align:center;
  border-radius:30px;
  background:rgba(255,255,255,.09);
  border:1px solid rgba(255,255,255,.12);
  box-shadow:0 20px 70px rgba(0,0,0,.5);
  backdrop-filter:blur(15px);
  -webkit-backdrop-filter:blur(15px);
}

h1{
  margin:0 0 10px;
  font-size:27px;
}

.subtitle{
  line-height:2;
  opacity:.85;
}

.main-circle{
  width:145px;
  height:145px;
  margin:30px auto;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:62px;
  cursor:pointer;
  user-select:none;
  background:linear-gradient(145deg,#ff4d91,#8b1764);
  box-shadow:0 0 25px #ff4d91,0 0 70px rgba(255,77,145,.5);
  animation:pulse 2s infinite;
}

@keyframes pulse{
  0%,100%{transform:scale(1)}
  50%{transform:scale(1.07)}
}

.thanks{
  display:none;
  margin:15px 0;
  line-height:2;
  animation:appear .6s;
}

.thanks.show{
  display:block;
}

.panel{
  display:none;
  margin-top:20px;
  padding:20px;
  border-radius:25px;
  background:rgba(0,0,0,.3);
}

.panel.show{
  display:block;
  animation:appear .5s;
}

.item{
  margin:10px 0;
  padding:15px;
  border-radius:18px;
  background:rgba(255,255,255,.08);
  cursor:pointer;
  user-select:none;
  transition:.2s;
}

.item:active{
  transform:scale(.97);
}

.message{
  display:none;
  margin-top:15px;
  padding:15px;
  border-radius:18px;
  background:rgba(255,77,145,.18);
  line-height:2;
  animation:appear .4s;
}

.message.show{
  display:block;
}

.buttons{
  display:flex;
  gap:10px;
  justify-content:center;
  margin-top:18px;
}

button{
  border:0;
  padding:12px 25px;
  border-radius:30px;
  color:white;
  font-size:16px;
  font-family:inherit;
  cursor:pointer;
  user-select:none;
}

.yes{
  background:#e93679;
}

.no{
  background:#555;
}

button:active{
  transform:scale(.95);
}

.gift-hint{
  display:none;
  position:fixed;
  left:50%;
  bottom:78px;
  transform:translateX(-50%);
  width:90%;
  max-width:330px;
  text-align:center;
  font-size:14px;
  line-height:1.8;
  animation:giftHint 1.5s infinite alternate;
  z-index:20;
}

.gift-hint.show{
  display:block;
}

.secret{
  display:none;
  position:fixed;
  left:50%;
  bottom:15px;
  transform:translateX(-50%);
  width:58px;
  height:58px;
  align-items:center;
  justify-content:center;
  font-size:40px;
  cursor:pointer;
  z-index:21;
  animation:giftPulse 1.5s infinite;
}

.secret.show{
  display:flex;
}

@keyframes giftPulse{
  0%,100%{
    transform:translateX(-50%) scale(1)
  }
  50%{
    transform:translateX(-50%) scale(1.15)
  }
}

@keyframes giftHint{
  from{opacity:.65}
  to{opacity:1}
}

.secret-message{
  display:none;
  position:fixed;
  inset:0;
  align-items:center;
  justify-content:center;
  padding:20px;
  background:rgba(0,0,0,.78);
  z-index:100;
}

.secret-message.show{
  display:flex;
}

.secret-box{
  width:100%;
  max-width:350px;
  padding:30px 22px;
  text-align:center;
  border-radius:25px;
  background:linear-gradient(145deg,#7d1c60,#27091f);
  box-shadow:0 0 50px rgba(255,100,180,.5);
  animation:appear .5s;
}

.final{
  display:none;
  margin-top:20px;
  padding:20px;
  border-radius:22px;
  background:rgba(255,255,255,.1);
  line-height:2;
  animation:appear .7s;
}

.final.show{
  display:block;
}

.final-love{
  margin-top:18px;
  padding:15px;
  border-radius:18px;
  background:rgba(255,77,145,.15);
  line-height:2;
}

.last-message{
  margin-top:20px;
  padding:18px;
  border-radius:20px;
  background:linear-gradient(
    145deg,
    rgba(255,77,145,.22),
    rgba(255,255,255,.08)
  );
  line-height:2;
  box-shadow:0 0 25px rgba(255,77,145,.15);
}

.last-message .signature{
  margin-top:15px;
  font-size:18px;
  font-weight:bold;
}

.heart{
  position:fixed;
  bottom:-40px;
  pointer-events:none;
  font-size:22px;
  animation:float linear forwards;
  z-index:50;
}

@keyframes float{
  to{
    transform:translateY(-110vh) rotate(360deg);
    opacity:0;
  }
}

@keyframes appear{
  from{
    opacity:0;
    transform:translateY(15px);
  }
  to{
    opacity:1;
    transform:translateY(0);
  }
}
</style>
</head>

<body>

<div class="container">

<div class="card">

<h1>Elena ❤️ Nikan</h1>

<div class="subtitle">
یه چیز کوچیک برات آماده کردم...<br>
روی قلب بزن ✨
</div>

<div class="main-circle" onclick="openHeart()">
❤️
</div>

<div class="thanks" id="thanks">
💗 ممنون که همراه منی 💗<br>
حالا یه چیز دیگه هم منتظرت هست...
</div>

<div class="panel" id="panel">

<h2>چیزهایی که برای تو آماده شده 💕</h2>

<div class="item" onclick="showMessage('letter')">
💌 یه پیام برای تو
</div>

<div class="item" onclick="showMessage('question')">
❤️ یه سؤال مهم
</div>

<div class="message" id="letter">
بعضی آدم‌ها فقط وارد زندگی آدم نمی‌شن...<br>
یه گوشه از قلب آدم رو برای همیشه قشنگ می‌کنن. ❤️
</div>

<div class="message" id="question">

یه سؤال کوچولو دارم...<br><br>

می‌خوای ادامه بدیم؟ ❤️

<div class="buttons">

<button class="yes" onclick="sayYes()">
بله ❤️
</button>

<button class="no" onclick="sayNo()">
نه
</button>

</div>

<div id="result"></div>

</div>


<div class="final" id="final">

🌹 رسیدیم به آخرش...<br><br>

ممنون که تا اینجا همراه من اومدی. ❤️<br>

بعضی لحظه‌ها شاید کوتاه باشن،
ولی می‌تونن برای همیشه قشنگ بمونن. ✨

<br><br>

<div class="final-love">

💌 از طرف نیکان:<br><br>

«النا، شاید نتونم همیشه قشنگ‌ترین جمله‌ها رو پیدا کنم،
ولی یه چیز رو خوب می‌دونم؛
حضورت برای من یکی از قشنگ‌ترین اتفاق‌های زندگیه. ❤️»

<br><br>

😳 عه؟!<br>

مگه ما تازه شروع نکردیم؟ 😂❤️

<br><br>

خب... ادامه بدیم؟ 😄

<div class="buttons">

<button class="yes" onclick="finalYes()">
آره ❤️
</button>

<button class="no" onclick="finalNo()">
نه 😄
</button>

</div>

<div id="finalResult"></div>

</div>


<!-- پیام پایانی جدید -->

<div class="last-message">

💌 ممنون که تا اینجا باهام همراه شدی ❤️

<br><br>

ادامه‌ی این داستان رو دیگه بذاریم برای پیوی... 😄💗

<br><br>

با تشکر ازت که باهام همراه شدی ✨

<div class="signature">
نیکان ❤️
</div>

</div>

</div>

</div>

</div>
</div>


<!-- کادوی پایین صفحه -->

<div class="gift-hint" id="giftHint">

یه کادویی پایین صفحه برات دارم 🎁<br>

روش بزن تا بازش کنی ❤️

</div>

<div class="secret" id="gift" onclick="openSecret()">
🎁
</div>


<!-- پنجره مخفی -->

<div class="secret-message" id="secretMessage">

<div class="secret-box">

<h2>🎁 پیدام کردی!</h2>

<p>
قرار نبود اینو ببینی 😄<br><br>

ولی حالا که پیداش کردی...<br>

این پیام مخصوص خودته ❤️
</p>

<button class="yes" onclick="closeSecret()">
باشه ❤️
</button>

</div>

</div>


<script>

let opened = false;


function openHeart(){

  if(opened) return;

  opened = true;

  document.body.classList.add("bright");

  document.getElementById("panel").classList.add("show");

  document.getElementById("thanks").classList.add("show");

  document.getElementById("giftHint").classList.add("show");

  document.getElementById("gift").classList.add("show");

  createHearts(30);
}


function showMessage(id){

  document.querySelectorAll(".message").forEach(function(item){

    item.classList.remove("show");

  });

  document.getElementById(id).classList.add("show");
}


function sayYes(){

  document.getElementById("result").innerHTML =
  "🥰 پس بریم برای ادامه‌ی داستان... ❤️";

  createHearts(18);

  setTimeout(function(){

    document.getElementById("final").classList.add("show");

  },1000);
}


function sayNo(){

  document.getElementById("result").innerHTML =
  "❌ همچین گزینه‌ای وجود نداره 😄❤️";

  createHearts(8);
}


function finalYes(){

  document.getElementById("finalResult").innerHTML =
  "🥰 می‌دونستم! پس تازه اول داستانه ❤️✨";

  createHearts(25);
}


function finalNo(){

  document.getElementById("finalResult").innerHTML =
  "😂 نه بابا، شوخی نکن! قلبم ضعیفه 😄❤️ جون من قبول کن";

  createHearts(10);
}


function openSecret(){

  document.getElementById("giftHint").classList.remove("show");

  document.getElementById("gift").classList.remove("show");

  document.getElementById("secretMessage").classList.add("show");

  createHearts(15);
}


function closeSecret(){

  document.getElementById("secretMessage").classList.remove("show");

}


function createHearts(count){

  for(let i=0;i<count;i++){

    const heart = document.createElement("div");

    heart.className = "heart";

    heart.textContent =
      Math.random() > 0.5 ? "❤️" : "💗";

    heart.style.left =
      Math.random() * 100 + "vw";

    heart.style.animationDuration =
      (3 + Math.random() * 4) + "s";

    document.body.appendChild(heart);

    setTimeout(function(){

      heart.remove();

    },7000);

  }

}

</script>

</body>
</html>
